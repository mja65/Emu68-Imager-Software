# Amiga packages and compressed boot artifacts are binary. Git must never
# normalize their contents or attempt to produce text diffs.
*.lha binary
*.lzx binary
*.zip binary
*.gz binary

# Disk images, ROMs, firmware, executables, Amiga icons, and preferences are
# binary as well. Keep these patterns explicit when adding new bundled assets.
*.adf binary
*.hdf binary
*.img binary
*.iso binary
*.rom binary
*.bin binary
*.elf binary
*.dat binary
*.info binary
*.prefs binary
*.csv binary
*.library binary
*.device binary
*.card binary
*.___ binary

# Raster images are binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

# Text consumed on the Amiga or Raspberry Pi must be LF-only. These rules are
# intentionally explicit because many binary Amiga files have no extension.
Assets/AmigaFiles/EMU68Boot/*.txt text eol=lf

# Amiga packages and compressed boot artifacts are binary. Git must never
# normalize their contents or attempt to produce text diffs.
*.lha binary
*.lzx binary
*.zip binary
*.gz binary

# Disk images, ROMs, firmware, executables, Amiga icons, and preferences are
# binary as well. Keep these patterns explicit when adding new bundled assets.
*.adf binary
*.hdf binary
*.img binary
*.iso binary
*.rom binary
*.bin binary
*.elf binary
*.dat binary
*.info binary
*.prefs binary
*.csv binary
*.library binary
*.device binary
*.card binary
*.___ binary

# Raster images are binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

# Text files copied to the Amiga/RPi need LF line endings. Keep the rules
# scoped: System also contains Amiga executables and other binary files.
Assets/AmigaFiles/EMU68Boot/*.txt text eol=lf
Assets/AmigaFiles/System/**/*.rexx text eol=lf
Assets/AmigaFiles/System/**/*.txt text eol=lf
Assets/AmigaFiles/System/**/*.r text eol=lf
Assets/AmigaFiles/System/**/*.info.txt text eol=lf

# Text files without a filename extension.
Assets/AmigaFiles/System/Devs/DOSDrivers/SD0pi[34] text eol=lf
Assets/AmigaFiles/System/Devs/NetInterfaces/genet text eol=lf
Assets/AmigaFiles/System/Devs/NetInterfaces/wifipi text eol=lf
Assets/AmigaFiles/System/OneTimeRun/** text eol=lf
Assets/AmigaFiles/System/OneTimeRunWB/** text eol=lf
Assets/AmigaFiles/System/PiStorm/DebugTools/Check* text eol=lf
Assets/AmigaFiles/System/PiStorm/Documentation text eol=lf
"Assets/AmigaFiles/System/PiStorm/Install Packages" text eol=lf
Assets/AmigaFiles/System/PiStorm/Network/*ScriptMenu* text eol=lf
Assets/AmigaFiles/System/PiStorm/RoadshowParameters text eol=lf
Assets/AmigaFiles/System/PiStorm/TransferKick text eol=lf
Assets/AmigaFiles/System/Prefs/Env-Archive/FIRSTTIMEBOOT* text eol=lf
Assets/AmigaFiles/System/Prefs/Env-Archive/REBOOT text eol=lf
Assets/AmigaFiles/System/Prefs/Env-Archive/genet_*.prefs text eol=lf
Assets/AmigaFiles/System/Prefs/Env-Archive/Sys/wireless.prefs text eol=lf
Assets/AmigaFiles/System/Programs/DOpus/C/DOpusEdit text eol=lf

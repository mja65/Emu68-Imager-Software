<Window x:Class="WpfApp14.LanguageSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select Languages" Height="450" Width="630" HorizontalAlignment="Center" VerticalAlignment="Center" Topmost="True" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Select the languages you wish to include:" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" BorderBrush="#CCC" BorderThickness="1" Padding="10">
            <UniformGrid Columns="2">
                <CheckBox x:Name="English_checkbox" Content="English" Margin="0,4"/>
                <CheckBox x:Name="EnglishUK_checkbox" Content="English (GB) - English (UK)" Margin="0,4"/>
                <CheckBox x:Name="Bosnian_checkbox" Content="Bosnian (BS) - Bosanski" Margin="0,4"/>
                <CheckBox x:Name="Catalan_checkbox" Content="Catalan (CA) - Catal&#xe0;" Margin="0,4"/>
                <CheckBox x:Name="Croatian_checkbox" Content="Croatian (HR) - Hrvatski" Margin="0,4"/>
                <CheckBox x:Name="Czech_checkbox" Content="Czech (CZ) - &#x010c;e&#x0161;tina" Margin="0,4"/>                
                <CheckBox x:Name="Danish_checkbox" Content="Danish (DK) - Dansk" Margin="0,4"/>
                <CheckBox x:Name="Dutch_checkbox" Content="Dutch (NL) - Nederlands" Margin="0,4"/>
                <CheckBox x:Name="Finnish_checkbox" Content="Finnish (SU) - Suomi" Margin="0,4"/>
                <CheckBox x:Name="French_checkbox" Content="French (FR) - Fran&#xe7;ais" Margin="0,4"/>
                <CheckBox x:Name="German_checkbox" Content="German (DE) - Deutsch" Margin="0,4"/>
                <CheckBox x:Name="Greek_checkbox" Content="Greek (GR) - &#x0395;&#x03bb;&#x03bb;&#x03b7;&#x03bd;&#x03b9;&#x03ba;&#x03ac;" Margin="0,4"/>
                <CheckBox x:Name="Hungarian_checkbox" Content="Hungarian (HU) - Magyar" Margin="0,4"/>
                <CheckBox x:Name="Italian_checkbox" Content="Italian (IT) - Italiano" Margin="0,4"/>
                <CheckBox x:Name="Norwegian_checkbox" Content="Norwegian (NO) - Norsk" Margin="0,4"/>
                <CheckBox x:Name="Polish_checkbox" Content="Polish (PO) - Polski" Margin="0,4"/>
                <CheckBox x:Name="Portuguese_checkbox" Content="Portuguese (PT) - Portugu&#xea;s" Margin="0,4"/>
                <CheckBox x:Name="PortugueseBrazilian_checkbox" Content="Portuguese Brazilian (PT-br) - Portugu&#xea;s (Brasil)" Margin="0,4"/>
                <CheckBox x:Name="Russian_checkbox" Content="Russian (RU) - &#x0420;&#x0443;&#x0441;&#x0441;&#x043a;&#x0438;&#x0439;" Margin="0,4"/>
                <CheckBox x:Name="Serbian_checkbox" Content="Serbian (SR) - Srpski" Margin="0,4"/>
                <CheckBox x:Name="Slovakian_checkbox" Content="Slovakian (SK) - Sloven&#x010d;ina" Margin="0,4"/>
                <CheckBox x:Name="Spanish_checkbox" Content="Spanish (ES) - Espa&#xf1;ol" Margin="0,4"/>
                <CheckBox x:Name="Swedish_checkbox" Content="Swedish (SE) - Svenska" Margin="0,4"/>
                <CheckBox x:Name="Turkish_checkbox" Content="Turkish (TR) - T&#xfc;rk&#xe7;e" Margin="0,4"/>
            </UniformGrid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="OK_Button" Content="OK" Width="80" Height="26" Margin="0,0,10,0" IsDefault="True" />
            <Button x:Name="Cancel_Button" Content="Cancel" Width="80" Height="26" />
        </StackPanel>
    </Grid>
</Window>
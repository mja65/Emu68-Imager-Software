<Window x:Name="Window" 
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:WpfApp14"
            mc:Ignorable="d"
         Title="Edit Unicam Settings" Height="350" Width="420" Left="130" HorizontalAlignment="Center" VerticalAlignment="Center" Topmost="True" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid x:Name ="Main" Background="#FFE5E5E5">
        <Button x:Name="OK_Button" Content="OK" HorizontalAlignment="Right" Margin="0,0,5,5" VerticalAlignment="Bottom" Width="50" Height="20"/>
        <Button x:Name="Cancel_Button" Content="Cancel" HorizontalAlignment="Left" Margin="5,0,0,5" VerticalAlignment="Bottom" Width="50" Height="20"/>
           <GroupBox  x:Name="Unicam_Type_Groupbox" Header="Device Type" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="65" Width="190" >
            <Grid>
                <RadioButton x:Name="Unicam_Type_FT_radiobutton" Content="Framethrower" HorizontalAlignment="Left" Margin="10,5,0,0" VerticalAlignment="Top"/>
                <RadioButton x:Name="Unicam_Type_C790_radiobutton" Content="C790" HorizontalAlignment="Left" Margin="10,25,0,0" VerticalAlignment="Top"/>
            </Grid>
        </GroupBox>
        <CheckBox x:Name="Unicam_StartBoot_checkBox" Content="Start on Boot" HorizontalAlignment="Left" Margin="10,80,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="Unicam_EnableScanLines_checkBox" Content="Enable Scanlines" HorizontalAlignment="Left" Margin="220,80,0,0" VerticalAlignment="Top"/>
        <GroupBox  x:Name="Unicam_Scaling_Groupbox" Header="Scaling" Margin="10,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="65" Width="190" >
            <Grid>
                <RadioButton x:Name="Unicam_IntegerScaling_radioButton" Content="Integer only Scaling" HorizontalAlignment="Left" Margin="10,5,0,0" VerticalAlignment="Top"/>
                <RadioButton x:Name="Unicam_SmoothScaling_radioButton" Content="Smooth Scaling" HorizontalAlignment="Left" Margin="10,25,0,0" VerticalAlignment="Top"/>
            </Grid>

        </GroupBox>

        <GroupBox x:Name="Unicam_Scanlines_Groupbox" Visibility="Visible" Header="Scanlines" Margin="0,100,10,0" Height="100" Width="190" HorizontalAlignment="Right" VerticalAlignment="Top"  >
            <Grid>
                <TextBox x:Name="Scanlines_Label" HorizontalAlignment="Center" Margin="0,0,0,0" TextWrapping="Wrap" Text="Nonlaced" VerticalAlignment="Top" Height="20"  BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" FontWeight="Bold" FontSize="10" Width="55"/>
                <Slider x:Name="Scanlines_slider" Margin="10,15,58,0" VerticalAlignment="Top" Maximum="4" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True"/>
                <TextBox x:Name="Scanlines_value" HorizontalAlignment="Left" Margin="130,15,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="15" Height="20" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False"/>
                <TextBox x:Name="ScanlinesInterlaced_Label" HorizontalAlignment="Center" Margin="0,35,0,0" TextWrapping="Wrap" Text="Laced" VerticalAlignment="Top" Height="20"  BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" FontWeight="Bold" FontSize="10" Width="55"/>
                <Slider x:Name="ScanlinesInterlaced_slider" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top" Width="120" Maximum="4" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True"/>
                <TextBox x:Name="ScanlinesInterlaced_value" HorizontalAlignment="Left" Margin="130,50,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="15" Height="20" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False"/>

            </Grid>

        </GroupBox>

        <GroupBox x:Name="Unicam_B_Parameter_Groupbox" Header="B Parameter" Margin="10,170,0,0" Height="40" Width="190" HorizontalAlignment="Left" VerticalAlignment="Top"  >
            <Grid>
                <Slider x:Name="B_Parameter_slider" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Width="120" Maximum="1000" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True"/>
                <TextBox x:Name="B_Parameter_Input" HorizontalAlignment="Left" Margin="130,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="50" Height="20"/>
            </Grid>
        </GroupBox>
        <GroupBox x:Name="Unicam_C_Parameter_Groupbox" Header="C Parameter" Margin="10,215,0,0" Height="40" Width="190" HorizontalAlignment="Left" VerticalAlignment="Top"  >
            <Grid>
                <Slider x:Name="C_Parameter_slider" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Width="120" Maximum="1000" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True"/>
                <TextBox x:Name="C_Parameter_Input" HorizontalAlignment="Left" Margin="130,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="50" Height="20"/>
            </Grid>
        </GroupBox>
        <GroupBox x:Name="Aspect_Groupbox" Visibility="Hidden" Header="Aspect Ratio" Margin="10,235,0,0" Height="40" Width="190" HorizontalAlignment="Left" VerticalAlignment="Top"  >
            <Grid>
                <Slider x:Name="Phase_slider" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Width="120" Maximum="1000" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True"/>
                <TextBox x:Name="Phase_Input" HorizontalAlignment="Left" Margin="130,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="50" Height="20"/>
            </Grid>
        </GroupBox>

        <GroupBox x:Name="Unicam_PositionandSize_Groupbox" Visibility="Hidden" Header="Position &amp; Size" Margin="10,280,0,0" Height="159" Width="190" HorizontalAlignment="Left" VerticalAlignment="Top"  >
            <Grid>
                <GroupBox x:Name="Unicam_Size_Groupbox" Header="Size" Margin="10,0,0,0" Height="60" Width="130" HorizontalAlignment="Left" VerticalAlignment="Top"  >
                    <Grid>
                        <TextBox x:Name="Size_X_Label" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,0" TextWrapping="Wrap" Text="X" VerticalAlignment="Top" Height="20"  BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" FontWeight="Bold" FontSize="10" Width="50"/>
                        <TextBox x:Name="Size_X_Input" HorizontalAlignment="Left" Margin="0,20,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="50" Height="20"/>
                        <TextBox x:Name="Size_Y_Label" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="60,0,0,0" TextWrapping="Wrap" Text="Y" VerticalAlignment="Top" Height="20"  BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" FontWeight="Bold" FontSize="10" Width="50"/>
                        <TextBox x:Name="Size_Y_Input" HorizontalAlignment="Left" Margin="60,20,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="50" Height="20"/>
                    </Grid>
                </GroupBox>
                <GroupBox x:Name="Unicam_Offset_Groupbox" Header="Offset" Margin="10,65,0,0" Height="60" Width="130" HorizontalAlignment="Left" VerticalAlignment="Top"  >
                    <Grid>
                        <TextBox x:Name="Offset_X_Label" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,0" TextWrapping="Wrap" Text="X" VerticalAlignment="Top" Height="20"  BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" FontWeight="Bold" FontSize="10" Width="50"/>
                        <TextBox x:Name="Offset_X_Input" HorizontalAlignment="Left" Margin="0,20,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="50" Height="20"/>
                        <TextBox x:Name="Offset_Y_Label" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="60,0,0,0" TextWrapping="Wrap" Text="Y" VerticalAlignment="Top" Height="20"  BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" FontWeight="Bold" FontSize="10" Width="50"/>
                        <TextBox x:Name="Offset_Y_Input" HorizontalAlignment="Left" Margin="60,20,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="50" Height="20"/>
                    </Grid>
                </GroupBox>
                <GroupBox x:Name="Unicam_Phase_Groupbox" Header="Phase" Margin="10,248,0,0" Height="40" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top"  >
                    <Grid>
                        <Slider x:Name="Aspect_slider" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Width="120" Maximum="1000" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True"/>
                        <TextBox x:Name="Aspect_Input" HorizontalAlignment="Left" Margin="130,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="50" Height="20"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
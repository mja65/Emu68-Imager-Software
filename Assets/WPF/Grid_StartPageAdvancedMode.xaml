      <Grid x:Name="Window_StartPage" Background="Transparent"  Margin="200,100,0,0" HorizontalAlignment="Left" Width="1000" Height="800" VerticalAlignment = "Top" Visibility="Visible"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:WpfApp14"
mc:Ignorable="d">

        <GroupBox x:Name="SettingsEmu68Imager_GroupBox" Header="Settings"  Background="Transparent" Margin="7,30,0,128" VerticalAlignment="Top" HorizontalAlignment="Left" Height="120" Width="220" Visibility="Visible">
                <Grid Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBox x:Name="DeleteFiles_Label" Margin="25,5,0,0" TextWrapping="Wrap" Text="Delete Existing Downloaded Files" VerticalAlignment="Top" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" TextAlignment="Left"/>
                <CheckBox x:Name="DeleteFiles_CheckBox" Content="Delete Existing DownloadedFiles" HorizontalAlignment="Left" Margin="5,5,0,0" VerticalAlignment="Top" Height="15" Width="15" IsChecked="False"/>
                <TextBox x:Name="RunParallel_Label" Margin="25,25,0,0" TextWrapping="Wrap" Text="Download Files in Parallel" VerticalAlignment="Top" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" TextAlignment="Left"/>
                <CheckBox x:Name="RunParallel_CheckBox" Content="Delete Existing DownloadedFiles" HorizontalAlignment="Left" Margin="5,25,0,0" VerticalAlignment="Top" Height="15" Width="15" IsChecked="False"/>
                <TextBox x:Name="Emu68Version_Label" HorizontalAlignment="Left" Margin="5,45,0,0" TextWrapping="Wrap" Width="200" Text="Select Emu68 Version" VerticalAlignment="Top" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="14"/>
                <ComboBox x:Name="Emu68Version_DropDown" HorizontalAlignment="Left" Margin="5,70,0,0" VerticalAlignment="Top" Width="190"/>
                </Grid>
            </GroupBox>

          <GroupBox x:Name="OSSelection_GroupBox" Header="OS Selection"  Background="Transparent" Margin="7,30,0,128" VerticalAlignment="Top" HorizontalAlignment="Center" Width="540">
              <Grid Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <TextBox x:Name="KickstartVersion_Label" HorizontalAlignment="Left" Margin="10,10,10,0" TextWrapping="Wrap" Text="Select OS Version" VerticalAlignment="Top" Width="200" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="14"/>
                  <ComboBox x:Name="KickstartVersion_DropDown" ToolTip="Select the Kickstart version you wish to use (e.g. 3.1 or 3.2)" HorizontalAlignment="Left" Margin="10,32,10,0" VerticalAlignment="Top" Width="300"/>

              </Grid>
          </GroupBox>
          <GroupBox x:Name="SourceFiles_GroupBox" Header="Source Files" Background="Transparent" Margin="7,120,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="540">
              <Grid Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <Button x:Name="ADFpath_Button" ToolTip="Click to set custom Install files folder" Content="Click to set Install Media folder" HorizontalAlignment="Left" Margin="10,60,0,0" VerticalAlignment="Top"  Width="200" Height="30"/>
                  <Button x:Name="ADFpath_Button_Check" ToolTip="Check availability of Install files" Content="Check" HorizontalAlignment="Left" Margin="215,60,0,0" VerticalAlignment="Top"  Width="40" Height="30" FontSize="10"/>
                  <TextBox x:Name="ADFPath_Label" HorizontalAlignment="Left" Margin="263,60,0,0" TextWrapping="Wrap" VerticalContentAlignment="Center" Text="Using default install media folder" VerticalAlignment="Top" Width="260" Height="30"  BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False"/>

                  <Button x:Name="Rompath_Button" ToolTip="Click to set custom Kickstart files folder" Content="Click to set Kickstart folder" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"  Width="200" Height="30"/>
                  <Button x:Name="Rompath_Button_Check" ToolTip="Check availability of Kickstart file" Content="Check" HorizontalAlignment="Left" Margin="215,10,0,0" VerticalAlignment="Top"  Width="40" Height="30" FontSize="10"/>
                  <TextBox x:Name="ROMPath_Label" HorizontalAlignment="Left" Margin="263,10,0,0" TextWrapping="Wrap" VerticalContentAlignment="Center" Text="Using default Kickstart folder" VerticalAlignment="Top" Width="260" Height="30"  BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False"/>

              </Grid>
          </GroupBox>

          <GroupBox x:Name="SettingsNetworkUSB_GroupBox" Header="Network &amp; USB Settings" Height="175" Background="Transparent" Margin="154,300,0,0" Width="400" VerticalAlignment="Top" HorizontalAlignment="Right">
              <Grid>
                <TextBox x:Name="NetworkStack_Label" HorizontalAlignment="Left" Margin="10,5,0,0" TextWrapping="Wrap" Text="TCP/IP Stack" VerticalAlignment="Top" Width="85" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False"/>
                <ComboBox x:Name="NetworkStack_Dropdown" ToolTip="" HorizontalAlignment="Left" Margin="100,5,0,0" VerticalAlignment="Top" Width="275"/>
                <TextBox x:Name="SSID_Label" HorizontalAlignment="Left" Margin="10,30,0,0" TextWrapping="Wrap" Text="SSID" VerticalAlignment="Top" Width="85" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False"/>
                <TextBox x:Name="Password_Label" HorizontalAlignment="Left" Margin="10,50,0,0" TextWrapping="Wrap" Text="Wifi password"  VerticalAlignment="Top" Width="85" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" />
                <TextBox x:Name="SSID_Textbox" ToolTip="Set your SSID for wifi on the Amiga (leave empty if you wish to configure on the Amiga)" HorizontalAlignment="Left" Margin="100,30,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="275" />
                <TextBox x:Name="Password_Textbox" ToolTip="Set your password for wifi on the Amiga (leave empty if you wish to configure on the Amiga)" HorizontalAlignment="Left" Margin="100,50,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="275" />
                <CheckBox x:Name="USBStackEnable_CheckBox" Content="Enable USB Stack (Raspberry Pi 4/CM4 Only)"  HorizontalAlignment="Left" Margin="10,75,0,0" VerticalAlignment="Top" IsChecked="False"/>
                <GroupBox x:Name="SettingsPoseidonVersion_GroupBox" Header="Poseidon Version" Height="50" Background="Transparent" Margin="0,100,0,0" Width="375" VerticalAlignment="Top" HorizontalAlignment="Center">
                   <Grid>
                          <RadioButton x:Name="PoseidonVersion_RadioButton45" Content="4.5" HorizontalAlignment="Left" Margin="10,5,0,0" Height="20" VerticalAlignment="Top" Width="75"/>
                          <RadioButton x:Name="PoseidonVersion_RadioButtonRondoval" Content="6.x (AROS Backport)" HorizontalAlignment="Left" Margin="70,5,0,0" Height="20" VerticalAlignment="Top" Width="130" />

                      </Grid>
                  </GroupBox>
              </Grid>
          </GroupBox>

          <GroupBox x:Name="SettingsMUIVersion_GroupBox" Header="MUI Version" Height="50" Background="Transparent" Margin="154,250,0,0" Width="400" VerticalAlignment="Top" HorizontalAlignment="Right">
              <Grid>
                 
                  <RadioButton x:Name="MUIVersion_38" Content="3.8" HorizontalAlignment="Left" Margin="10,5,0,0" Height="20" VerticalAlignment="Top" Width="75" />
                  <RadioButton x:Name="MUIVersion_50" Content="5.0" HorizontalAlignment="Left" Margin="60,5,0,0" Height="20" VerticalAlignment="Top" Width="55"/>

              </Grid>
          </GroupBox>

          <GroupBox x:Name="SettingsSDCard_GroupBox" Header="Emu68 Settings" Height="200" Background="Transparent" Margin="154,475,0,0" Width="400" VerticalAlignment="Top" HorizontalAlignment="Right" Visibility="Visible">
              <Grid>

                  <CheckBox x:Name="LowSpeed_CheckBox" Content="Enable Low Speed Option (for SD Extenders)" HorizontalAlignment="Left" Margin="5,5,0,0" VerticalAlignment="Top" IsChecked="False"/>
                  <CheckBox x:Name="EnableBuptest_CheckBox" Content="Enable Buptest on First Boot" HorizontalAlignment="Left" Margin="5,25,0,0" VerticalAlignment="Top" IsChecked="False"/>
                  <CheckBox x:Name="DisableSCSI_CheckBox" Content="Disable scsi.device" HorizontalAlignment="Left" Margin="5,45,0,0" VerticalAlignment="Top" IsChecked="False"/>
                  <CheckBox x:Name="ForceAgnus_CheckBox" Content="Force Agnus Type" HorizontalAlignment="Left" Margin="5,65,0,0" VerticalAlignment="Top" IsChecked="False"/>
                  <RadioButton x:Name="ForceAgnus_RadioButtonNTSC" Content="NTSC" HorizontalAlignment="Left" Margin="140,65,0,0" VerticalAlignment="Top"/>
                  <RadioButton x:Name="ForceAgnus_RadioButtonPAL" Content="PAL" HorizontalAlignment="Left" Margin="195,65,0,0" VerticalAlignment="Top"/>
                  <CheckBox x:Name="EnableDMA_CheckBox" Content="Enable DMA" HorizontalAlignment="Left" Margin="5,85,0,0" VerticalAlignment="Top" IsChecked="False"/>
                  <CheckBox x:Name="EnableIRQ_CheckBox" Content="Enable IRQ" HorizontalAlignment="Left" Margin="5,105,0,0" VerticalAlignment="Top" IsChecked="False"/>
                  <CheckBox x:Name="OverclockSD_CheckBox" Content="SD Card Speed" HorizontalAlignment="Left" Margin="5,125,0,0" VerticalAlignment="Top" IsChecked="False"/>
                  <Slider x:Name="OverclockSD_Slider" HorizontalAlignment="Left" Margin="170,125,0,0" VerticalAlignment="Top" Width="110" Maximum="100" Minimum="30" SmallChange="1" AutoToolTipPlacement="BottomRight" Foreground="Black" TickPlacement="BottomRight" IsSnapToTickEnabled="True" LargeChange="10" TickFrequency="10"/>
                  <TextBox x:Name="OverclockSD_Value" HorizontalAlignment="Left" Margin="285,125,0,0" TextWrapping="Wrap" Width="35" Text="50" VerticalAlignment="Top" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" HorizontalContentAlignment="Center" FontSize="12"/>
                  <TextBox x:Name="OverclockSD_Value_Text" HorizontalAlignment="Left" Margin="320,120,0,0" TextWrapping="Wrap" Width="65" Text="Warning! Overclock!" VerticalAlignment="Top" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" HorizontalContentAlignment="Center" FontSize="12"/>

              </Grid>

          </GroupBox>

          <GroupBox x:Name="SettingsScreen_GroupBox" Header="Screen Settings" Height="150" Background="Transparent" Margin="154,250,0,0" Width="400" VerticalAlignment="Top" HorizontalAlignment="Left">
              <Grid>

                  <ComboBox x:Name="ScreenMode_Dropdown" ToolTip="Select if you wish to use a specific resolution on your Raspberry Pi" HorizontalAlignment="Left" Margin="10,26,0,0" VerticalAlignment="Top" Width="375"/>
                  <TextBox x:Name="ScreenMode_Label" HorizontalAlignment="Left" Margin="10,0,0,0" TextWrapping="Wrap" Width="375" Text="Select ScreenMode for Raspberry Pi" VerticalAlignment="Top" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="14"/>
                  <Button x:Name="CustomScreenMode_button" Content="Click to set Custom Resolution" Width="375" Height="20" Margin="10,52,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Hidden" IsEnabled="False"/>
              </Grid>

          </GroupBox>
          <GroupBox x:Name="SettingsScreenWB_GroupBox" Header="Screen Settings - Workbench" Height="275" Background="Transparent" Margin="154,400,0,0" Width="400" VerticalAlignment="Top" HorizontalAlignment="Left">
              <Grid>
                  <TextBox x:Name="WorkbenchOutput_Label" HorizontalAlignment="Left" Margin="10,20,0,0" TextWrapping="Wrap" Text="Workbench Output" VerticalAlignment="Top" Width="120" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" TextAlignment="Center"/>

                  <RadioButton x:Name="WorkbenchOutput_RadioButtonNative" Content="Native" HorizontalAlignment="Left" Margin="140,10,0,0" VerticalAlignment="Top"/>
                  <RadioButton x:Name="WorkbenchOutput_RadioButtonRTG" Content="RTG" HorizontalAlignment="Left" Margin="140,30,0,0" VerticalAlignment="Top"/>

                  <CheckBox x:Name="Backdrop_CheckBox"  HorizontalAlignment="Left" Margin="247,16,0,0" IsEnabled="True" VerticalAlignment="Top"/>
                  <TextBox x:Name="Backdrop_CheckBox_Label" HorizontalAlignment="Left" Margin="264,13,0,0" TextWrapping="Wrap" Text="Workbench Backdrop" VerticalAlignment="Top" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" HorizontalContentAlignment="Left"  FontSize="12"/>

                  <ComboBox x:Name="ScreenModeWorkbench_Dropdown" ToolTip="Select if you wish to use a specific Workbench resolution" HorizontalAlignment="Left" Margin="10,80,0,0" VerticalAlignment="Top" Width="375"/>
                  <TextBox x:Name="ScreenModeWorkbench_Label" HorizontalAlignment="Left" Margin="10,50,0,0" TextWrapping="Wrap" Width="375" Text="Select ScreenMode for Workbench" VerticalAlignment="Top" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" HorizontalContentAlignment="Center" FontWeight="Bold" FontSize="14"/>
                  <GroupBox x:Name="ColourDepth_groupBox" Header="Colour Depth" Margin="0,80,0,0" Width="140" HorizontalAlignment="Left" Height="50" >
                      <Grid>
                          <Slider x:Name="WorkbenchColour_Slider" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top" Width="120" Maximum="24" Minimum="1" SmallChange="1" AutoToolTipPlacement="BottomRight" Foreground="Black" TickPlacement="BottomRight" IsSnapToTickEnabled="True"/>

                      </Grid>
                  </GroupBox>
                  <TextBox x:Name="WorkbenchColour_Label" HorizontalAlignment="Left" Margin="153,160,0,0" TextWrapping="Wrap" Width="120" Text="Number of Colours:" VerticalAlignment="Top" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" HorizontalContentAlignment="Center" FontSize="12"/>
                  <TextBox x:Name="WorkbenchColour_Value" HorizontalAlignment="Left" Margin="273,160,0,0" TextWrapping="Wrap" Width="40" Text="16.7M" VerticalAlignment="Top" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsUndoEnabled="False" IsTabStop="False" IsHitTestVisible="False" Focusable="False" HorizontalContentAlignment="Center" FontSize="12"/>


                  <CheckBox x:Name="Unicam_CheckBox" Content="Enable Unicam (Framethrower)" HorizontalAlignment="Left" Margin="10,195,0,0" Height="20" Width="195" IsEnabled="False" VerticalAlignment="Top"/>
                  <Button x:Name="Unicam_button" Content="Click to set Unicam Settings" Width="169" Height="20" Margin="200,195,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsEnabled="False"/>
              </Grid>

          </GroupBox>

      </Grid>


     <Grid x:Name="Window_StartPage" Background="Transparent" Margin="120,40,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="1000" Height="650"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
   xmlns:local="clr-namespace:WpfApp14"
   mc:Ignorable="d">

         <Grid.ColumnDefinitions>
             <ColumnDefinition Width="*" />
             <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>
         <Grid.RowDefinitions>
             <RowDefinition Height="Auto" />
             <RowDefinition Height="Auto" />
         </Grid.RowDefinitions>

         <!-- Left Column, Row 0: Settings (Includes merged Source Files content) -->
         <GroupBox x:Name="SettingsEmu68Imager_GroupBox" Header="Settings" Background="Transparent" Margin="3" Padding="6" Grid.Column="0" Grid.Row="0">
             <Grid>
                 <Grid.RowDefinitions>
                     <RowDefinition Height="Auto" />
                     <RowDefinition Height="Auto" />
                     <RowDefinition Height="Auto" />
                     <RowDefinition Height="Auto" />
                     <RowDefinition Height="Auto" />
                     <RowDefinition Height="Auto" />
                 </Grid.RowDefinitions>
                 <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="Auto" />
                     <ColumnDefinition Width="*" />
                 </Grid.ColumnDefinitions>

                 <CheckBox x:Name="DeleteFiles_CheckBox" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,8,2" IsChecked="False" ToolTip="Delete existing downloaded files before starting"/>
                 <TextBlock x:Name="DeleteFiles_Label" Grid.Row="0" Grid.Column="1" Text="Delete Existing Downloaded Files" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" ToolTip="Delete existing downloaded files before starting"/>

                 <CheckBox x:Name="RunParallel_CheckBox" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,8,2" IsChecked="False" ToolTip="Download files concurrently to improve download speed"/>
                 <TextBlock x:Name="RunParallel_Label" Grid.Row="1" Grid.Column="1" Text="Download Files in Parallel" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" ToolTip="Download files concurrently to improve download speed"/>

                 <TextBlock x:Name="Emu68Version_Label" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Select Emu68 Version" FontWeight="Bold" FontSize="12" Margin="0,6,0,2" HorizontalAlignment="Left"/>
                 <ComboBox x:Name="Emu68Version_DropDown" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Height="22" HorizontalAlignment="Stretch" Margin="0,0,0,6" ToolTip="Select the version of Emu68 to install"/>

                 <Separator Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,0,6"/>

                 <!-- Source Files Content -->
                 <Grid x:Name="SourceFiles_GridRow" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Visible">
                     <Grid.RowDefinitions>
                         <RowDefinition Height="Auto" />
                         <RowDefinition Height="Auto" />
                     </Grid.RowDefinitions>
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*" />
                         <ColumnDefinition Width="45" />
                         <ColumnDefinition Width="1.5*" />
                     </Grid.ColumnDefinitions>

                     <!-- ROM Path -->
                     <Button x:Name="Rompath_Button" Grid.Row="0" Grid.Column="0" ToolTip="Click to set custom Kickstart files folder" Content="Kickstart Folder" Height="24" Margin="0,0,4,4"/>
                     <Button x:Name="Rompath_Button_Check" Grid.Row="0" Grid.Column="1" ToolTip="Check availability of Kickstart file" Content="Check" Height="24" FontSize="10" Margin="0,0,4,4"/>
                     <TextBlock x:Name="ROMPath_Label" Grid.Row="0" Grid.Column="2" Text="Using default Kickstart folder" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,0,4" FontSize="11"/>

                     <!-- ADF Path -->
                     <Button x:Name="ADFpath_Button" Grid.Row="1" Grid.Column="0" ToolTip="Click to set custom Install files folder" Content="Install Media Folder" Height="24" Margin="0,0,4,0"/>
                     <Button x:Name="ADFpath_Button_Check" Grid.Row="1" Grid.Column="1" ToolTip="Check availability of Install files" Content="Check" Height="24" FontSize="10" Margin="0,0,4,0"/>
                     <TextBlock x:Name="ADFPath_Label" Grid.Row="1" Grid.Column="2" Text="Using default install media folder" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,0,0" FontSize="11"/>
                 </Grid>
             </Grid>
         </GroupBox>

         <!-- Right Column, Row 0: OS Selection -->
         <GroupBox x:Name="OSSelection_GroupBox" Header="OS Settings" Background="Transparent" Margin="3" Padding="6" Grid.Column="1" Grid.Row="0">
             <StackPanel>
                 <TextBlock x:Name="KickstartVersion_Label" Text="Select OS Version" FontWeight="Bold" FontSize="12" Margin="0,0,0,2" HorizontalAlignment="Left"/>
                 <ComboBox x:Name="KickstartVersion_DropDown" ToolTip="Select the Kickstart version you wish to use (e.g. 3.1 or 3.2)" Height="22" Margin="0,0,0,6"/>
                 <Button x:Name="LanguageSelection_Button" Content="Select Language(s)" Height="24" Margin="0,0,0,6" ToolTip="Click to configure system language preferences"/>

                 <TextBlock x:Name="IconSet_Label" Text="Select Icon Set" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"/>
                 <ComboBox x:Name="IconSet_DropDown" ToolTip="Select the icon set you wish to use" Height="22" Margin="0,0,0,2"/>
                 <TextBlock x:Name="IconSetDescription_Label" Visibility="Hidden" Text="Description of the selected icon set" TextWrapping="Wrap" FontSize="10" Foreground="#FF666666" Margin="0,0,0,6"/>

                 <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                     <TextBlock x:Name="MUIVersion_Label" Text="MUI Version:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" FontSize="12"/>
                     <RadioButton x:Name="MUIVersion_38" Content="3.8" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="12" ToolTip="Use Magic User Interface (MUI) version 3.8"/>
                     <RadioButton x:Name="MUIVersion_50" Content="5.0" VerticalAlignment="Center" FontSize="12" ToolTip="Use Magic User Interface (MUI) version 5.0"/>
                 </StackPanel>
             </StackPanel>
         </GroupBox>

         <!-- Left Column, Row 1: Unified Screen Settings Box -->
         <GroupBox x:Name="SettingsScreen_GroupBox" Header="Screen Settings" Background="Transparent" Margin="3" Padding="6" Grid.Column="0" Grid.Row="1">
             <Grid>
                 <Grid.RowDefinitions>
                     <RowDefinition Height="Auto" />
                     <RowDefinition Height="Auto" />
                     <RowDefinition Height="Auto" />
                 </Grid.RowDefinitions>
                 <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="*" />
                 </Grid.ColumnDefinitions>

                 <!-- Row 0: Raspberry Pi Screen Settings -->
                 <Grid x:Name="RPiScreenSettings_GridRow" Grid.Row="0" Visibility="Visible">
                     <StackPanel Margin="0,0,0,6">
                         <TextBlock x:Name="ScreenMode_Label" Text="Select ScreenMode for Raspberry Pi" FontWeight="Bold" FontSize="12" Margin="0,0,0,3" HorizontalAlignment="Left"/>
                         <ComboBox x:Name="ScreenMode_Dropdown" ToolTip="Select if you wish to use a specific resolution on your Raspberry Pi" Height="22" Margin="0,0,0,3"/>
                         <Button x:Name="CustomScreenMode_button" Content="Click to set Custom Resolution" Height="22" Visibility="Hidden" IsEnabled="False" Margin="0,0,0,4" ToolTip="Configure a custom Raspberry Pi video output resolution"/>
                     </StackPanel>
                 </Grid>

                 <!-- Row 1: Workbench Screen Settings & Color Depth / Unicam -->
                 <Grid x:Name="WorkbenchScreenSettings_GridRow" Grid.Row="1" Visibility="Visible">
                     <StackPanel Margin="0,0,0,6">
                         <Separator Margin="0,2,0,6"/>
                         <TextBlock x:Name="WorkbenchOutput_Label" Text="Workbench Output:" VerticalAlignment="Center" Margin="0,0,8,4" FontSize="11"/>
                         <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                             <RadioButton x:Name="WorkbenchOutput_RadioButtonNative" Content="Native" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" ToolTip="Set Workbench output to Native chipset display mode"/>
                             <RadioButton x:Name="WorkbenchOutput_RadioButtonRTG" Content="RTG" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" ToolTip="Set Workbench output to ReTargetable Graphics (RTG) mode"/>
                             <CheckBox x:Name="Backdrop_CheckBox" VerticalAlignment="Center" Margin="5,0,3,0" IsEnabled="True" ToolTip="Enable Workbench backdrop pattern/image"/>
                             <TextBlock x:Name="Backdrop_CheckBox_Label" Text="Backdrop" VerticalAlignment="Center" FontSize="11" ToolTip="Enable Workbench backdrop pattern/image"/>
                         </StackPanel>

                         <TextBlock x:Name="ScreenModeWorkbench_Label" Text="Select ScreenMode for Workbench" FontWeight="Bold" FontSize="12" Margin="0,2,0,2"/>
                         <ComboBox x:Name="ScreenModeWorkbench_Dropdown" Height="22" Margin="0,0,0,4" ToolTip="Select if you wish to use a specific Workbench resolution"/>

                         <Grid Margin="0,2,0,0">
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="Auto" />
                                 <ColumnDefinition Width="*" />
                             </Grid.ColumnDefinitions>
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto" />
                                 <RowDefinition Height="Auto" />
                             </Grid.RowDefinitions>

                             <GroupBox x:Name="ColourDepth_groupBox" Grid.Row="0" Grid.Column="0" Header="Colour Depth" Height="50" Margin="0,0,8,4" Padding="2,0,2,2">
                                 <Slider x:Name="WorkbenchColour_Slider" Width="90" Maximum="24" Minimum="1" SmallChange="1" AutoToolTipPlacement="BottomRight" TickPlacement="BottomRight" IsSnapToTickEnabled="True" ToolTip="Adjust the workbench color bit depth"/>
                             </GroupBox>

                             <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                 <TextBlock x:Name="WorkbenchColour_Label" Text="Colours:" FontSize="11" Margin="0,0,4,0"/>
                                 <TextBlock x:Name="WorkbenchColour_Value" Text="16.7M" FontSize="11" FontWeight="Bold"/>
                             </StackPanel>

                             <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,0">
                                 <CheckBox x:Name="Unicam_CheckBox" Content="Enable Unicam" Height="18" Width="110" IsEnabled="False" VerticalAlignment="Center" FontSize="11" ToolTip="Enable Unicam display capture driver support"/>
                                 <Button x:Name="Unicam_button" Content="Set Unicam Settings" Height="22" Width="130" IsEnabled="False" Margin="8,0,0,0" FontSize="11" ToolTip="Configure settings for the Unicam driver"/>
                             </StackPanel>
                         </Grid>
                     </StackPanel>
                 </Grid>

                 <!-- Row 2: Customise P96 Resolutions -->
                 <Grid x:Name="P96Row" Grid.Row="2" Visibility="Visible">
                     <StackPanel>
                         <Button x:Name="P96Resolutions_Button" Content="Customise P96 Resolutions" Height="24" Margin="0,2,0,0" ToolTip="Click to configure custom Picasso96 display resolutions"/>
                     </StackPanel>
                 </Grid>
             </Grid>
         </GroupBox>

         <!-- Right Column, Row 1: Network & USB Settings + Emu68 Settings -->
         <StackPanel Grid.Column="1" Grid.Row="1" Margin="0">
             <GroupBox x:Name="SettingsNetworkUSB_GroupBox" Header="Network &amp; USB Settings" Background="Transparent" Margin="3" Padding="4">
                 <StackPanel>
                     <Grid Margin="0,0,0,3">
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="80"/>
                             <ColumnDefinition Width="*"/>
                         </Grid.ColumnDefinitions>
                         <TextBlock x:Name="NetworkStack_Label" Grid.Column="0" Text="TCP/IP Stack" VerticalAlignment="Center" FontSize="11"/>
                         <ComboBox x:Name="NetworkStack_Dropdown" Grid.Column="1" Height="22" ToolTip="Select the TCP/IP networking stack to install"/>
                     </Grid>
                     <Grid Margin="0,0,0,3">
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="80"/>
                             <ColumnDefinition Width="*"/>
                         </Grid.ColumnDefinitions>
                         <TextBlock x:Name="SSID_Label" Grid.Column="0" Text="SSID" VerticalAlignment="Center" FontSize="11"/>
                         <TextBox x:Name="SSID_Textbox" Grid.Column="1" Height="22" ToolTip="Set your SSID for wifi on the Amiga (leave empty if you wish to configure on the Amiga)"/>
                     </Grid>
                     <Grid Margin="0,0,0,3">
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="80"/>
                             <ColumnDefinition Width="*"/>
                         </Grid.ColumnDefinitions>
                         <TextBlock x:Name="Password_Label" Grid.Column="0" Text="Wifi Password" VerticalAlignment="Center" FontSize="11"/>
                         <TextBox x:Name="Password_Textbox" Grid.Column="1" Height="22" ToolTip="Set your password for wifi on the Amiga (leave empty if you wish to configure on the Amiga)"/>
                     </Grid>
                     <CheckBox x:Name="USBStackEnable_CheckBox" Content="Enable USB Stack" Margin="0,2,0,3" FontSize="11" ToolTip="Enable USB host hardware stack support for Raspberry Pi 4 or CM4 boards"/>

                     <GroupBox x:Name="SettingsPoseidonVersion_GroupBox" Style="{DynamicResource BorderlessGroupBoxStyle}" Height="42" Background="Transparent" Padding="2">
                         <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                             <RadioButton x:Name="PoseidonVersion_RadioButton45" Content="Poseidon 4.5" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="11" ToolTip="Use Poseidon USB stack version 4.5"/>
                             <RadioButton x:Name="PoseidonVersion_RadioButtonRondoval" Content="Neptune 6.x" VerticalAlignment="Center" FontSize="11" ToolTip="Use Neptune USB stack version 6.x (AROS backport)" Width="80" Margin="0,0,15,0"/>
                             <CheckBox x:Name="CustomKickstart_CheckBox" Content="Add USB and associated drivers to Kickstart ROM" Margin="0,2,10,3" FontSize="11" ToolTip="Add USB support to the Kickstart ROM"/>
                         </StackPanel>
                     </GroupBox>
                 </StackPanel>
             </GroupBox>

             <GroupBox x:Name="SettingsSDCard_GroupBox" Header="Emu68 Settings" Background="Transparent" Margin="3" Padding="6" Visibility="Visible">
                 <Grid>
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*"/>
                         <ColumnDefinition Width="*"/>
                     </Grid.ColumnDefinitions>

                     <StackPanel Grid.Column="0">
                         <CheckBox x:Name="LowSpeed_CheckBox" Content="Enable Low Speed Option (SD Extenders)" Margin="0,9" FontSize="11" ToolTip="Lower SD card bus transfer speed for compatibility with SD extender cables"/>
                         <CheckBox x:Name="EnableBuptest_CheckBox" Content="Enable Buptest on First Boot" Margin="0,5" FontSize="11" ToolTip="Execute memory/hardware diagnostic test on initial boot sequence"/>
                         <CheckBox x:Name="DisableSCSI_CheckBox" Content="Disable scsi.device" Margin="0,5" FontSize="11" ToolTip="Disable internal scsi.device initialization in Emu68"/>
                         <StackPanel Orientation="Horizontal" Margin="0,2">
                             <CheckBox x:Name="ForceAgnus_CheckBox" Content="Force Agnus Type" VerticalAlignment="Center" Margin="0,4,10,0" FontSize="11" ToolTip="Override video timing mode for Agnus chipset"/>
                             <RadioButton x:Name="ForceAgnus_RadioButtonNTSC" Content="NTSC" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" ToolTip="Force NTSC (60Hz) timing mode"/>
                             <RadioButton x:Name="ForceAgnus_RadioButtonPAL" Content="PAL" VerticalAlignment="Center" FontSize="11" ToolTip="Force PAL (50Hz) timing mode"/>
                         </StackPanel>
                     </StackPanel>

                     <StackPanel Grid.Column="1">
                         <CheckBox x:Name="EnableDMA_CheckBox" Content="Enable DMA" Margin="0,9" FontSize="11" ToolTip="Enable direct memory access transfers"/>
                         <CheckBox x:Name="EnableIRQ_CheckBox" Content="Enable IRQ" Margin="0,5" FontSize="11" ToolTip="Enable hardware interrupt request handling"/>
                         <Grid Margin="0,2">
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="Auto"/>
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="Auto"/>
                                 <ColumnDefinition Width="Auto"/>
                             </Grid.ColumnDefinitions>
                             <CheckBox x:Name="OverclockSD_CheckBox" Grid.Column="0" Content="SD Speed" VerticalAlignment="Center" Margin="0,5,4,0" FontSize="11" ToolTip="Enable custom SD card bus overclock frequency"/>
                             <Slider x:Name="OverclockSD_Slider" Grid.Column="1" VerticalAlignment="Center" Maximum="100" Minimum="30" SmallChange="1" AutoToolTipPlacement="BottomRight" TickPlacement="BottomRight" IsSnapToTickEnabled="True" LargeChange="10" TickFrequency="10" Margin="0,0,4,0" ToolTip="Adjust SD clock frequency (MHz)"/>
                             <TextBlock x:Name="OverclockSD_Value" Grid.Column="2" Text="50" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,4,0" FontSize="11" ToolTip="Selected SD clock frequency in MHz"/>
                             <TextBlock x:Name="OverclockSD_Value_Text" Grid.Column="3" Text="Warning!" VerticalAlignment="Center" FontSize="10" Foreground="Red" ToolTip="High SD clock speeds may cause data corruption on unsupported cards"/>
                         </Grid>
                     </StackPanel>
                 </Grid>
             </GroupBox>
         </StackPanel>

     </Grid>
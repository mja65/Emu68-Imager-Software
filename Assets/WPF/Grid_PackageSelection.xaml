     <Grid x:Name="Window_PackageSelection" Background="Transparent" Margin="120,40,0,0" Height="600" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Visible"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:WpfApp14"
mc:Ignorable="d" Width="1100">

          <!-- Information Text block moved up cleanly -->
          <TextBlock x:Name="textBlock_packages" HorizontalAlignment="Left" Margin="20,15,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="540">
          If you want to change any of the packages selected for installation, unselect or select the relevant row. Note, if you decide you want this later on you will need to manually install it!
          </TextBlock>

          <!-- Reset Buttons properly spaced and aligned on the right -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,20,0">
              <Button x:Name="ResettoDefault" Content="Reset Packages to Default" Width="175" Height="24" Margin="0,0,10,0" Background="#FF6688BB" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" ToolTip="Click to reset all packages back to the default"/>
              <Button x:Name="ResetInstallPathstoDefault" Content="Reset Install Paths to Default" Width="185" Height="24" Background="#FF6688BB" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" ToolTip="Click to reset all packages back to the default"/>
          </StackPanel>

          <!-- DataGrid aligned to top matching details box -->
          <DataGrid Name="Datagrid_Packages" 
                CanUserAddRows="False" 
                HorizontalAlignment="Left" 
                AutoGenerateColumns="False" 
                Margin="20,60,0,25"  
                VerticalAlignment="Top" 
                HorizontalScrollBarVisibility="Auto" 
                GridLinesVisibility="None" 
                HorizontalGridLinesBrush="#FF505050" 
                VerticalGridLinesBrush="#FF505050" Height="480" Width="540">

              <DataGrid.Resources>
                  <!-- Center Column Headers Vertically & Horizontally -->
                  <Style TargetType="DataGridColumnHeader">
                      <Setter Property="HorizontalContentAlignment" Value="Center"/>
                      <Setter Property="VerticalContentAlignment" Value="Center"/>
                      <Setter Property="BorderThickness" Value="0"/>
                      <Setter Property="Padding" Value="4,2"/>
                  </Style>

                  <!-- Center Cell Contents Vertically & Horizontally -->
                  <Style TargetType="DataGridCell">
                      <Setter Property="HorizontalContentAlignment" Value="Center"/>
                      <Setter Property="VerticalContentAlignment" Value="Center"/>
                  </Style>

                  <!-- Enable Text Wrapping & Center Text Alignment for Cell Contents -->
                  <Style TargetType="TextBlock">
                      <Setter Property="TextWrapping" Value="Wrap"/>
                      <Setter Property="TextAlignment" Value="Center"/>
                  </Style>
              </DataGrid.Resources>

              <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="Select Package for Installation" Binding="{Binding PackageNameUserSelected}" Width="110">
                      <DataGridCheckBoxColumn.HeaderTemplate>
                          <DataTemplate>
                              <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                          </DataTemplate>
                      </DataGridCheckBoxColumn.HeaderTemplate>
                  </DataGridCheckBoxColumn>

                  <DataGridTextColumn Header="Name of Package" Binding="{Binding PackageNameFriendlyName, Mode=OneWay}" Width="235"/>
                  <DataGridTextColumn Header="Package Type" Binding="{Binding PackageNameGroup, Mode=OneWay}" Width="175"/>
                  <DataGridTextColumn Header="PackageNameDefaultInstall" Binding="{Binding PackageNameDefaultInstall, Mode=OneWay}" Visibility="Hidden"/>
              </DataGrid.Columns>
          </DataGrid>

          <!-- Package Details GroupBox structured cleanly using standard Grid rows -->
          <GroupBox x:Name="PackageDetails_GroupBox" Header="Package Details" Background="Transparent" Margin="0,60,20,25" Width="400" VerticalAlignment="Top" HorizontalAlignment="Right" Height="480">
              <Grid Background="Transparent" Margin="10">
                  <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="100"/>
                      <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- Title -->
                  <TextBox x:Name="Title_Label" Grid.Row="0" Grid.Column="0" Text="Title:" FontWeight="Bold" FontSize="12" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsTabStop="False" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,4"/>
                  <TextBox x:Name="Title_Value" Grid.Row="0" Grid.Column="1" Text="Author(s)" FontSize="12" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsTabStop="False" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,4"/>

                  <!-- Description -->
                  <TextBox x:Name="Description_Label" Grid.Row="1" Grid.Column="0" Text="Description:" FontWeight="Bold" FontSize="12" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsTabStop="False" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Top" Margin="0,4"/>
                  <Border Grid.Row="1" Grid.Column="1" BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White" Margin="0,4,0,8" Padding="4">
                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <TextBlock x:Name="PackageDetails_text" TextAlignment="Justify" TextWrapping="Wrap" Text="Package description text"/>
                      </ScrollViewer>
                  </Border>

                  <!-- Author(s) / Company -->
                  <TextBox x:Name="Author_Label" Grid.Row="2" Grid.Column="0" Text="Author(s) / Company:" TextWrapping="Wrap" FontWeight="Bold" FontSize="12" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsTabStop="False" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,4"/>
                  <TextBox x:Name="Author_Value" Grid.Row="2" Grid.Column="1" Text="Author(s)" FontSize="12" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsTabStop="False" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,4"/>

                  <!-- Webpage Link -->
                  <TextBox x:Name="Link_Label" Grid.Row="3" Grid.Column="0" Text="Webpage" FontWeight="Bold" FontSize="12" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsTabStop="False" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,4"/>
                  <TextBlock x:Name="Link_Value" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,4">
                  <Hyperlink x:Name="QuickStartDocumentationURL" FontSize="12" NavigateUri="https://mja65.github.io/Emu68-Imager/quickstart.html">hexcvxcvre</Hyperlink>
                  </TextBlock>

                  <!-- Install Drive -->
                  <TextBox x:Name="InstallDrive_Label" Grid.Row="4" Grid.Column="0" Text="Install Drive:" FontWeight="Bold" FontSize="12" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsTabStop="False" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,4"/>
                  <ComboBox x:Name="InstallDrive_Dropdown" Grid.Row="4" Grid.Column="1" Height="24" Width="120" HorizontalAlignment="Left" Margin="0,4"/>

                  <!-- Install Path -->
                  <TextBox x:Name="InstallPath_Label" Grid.Row="5" Grid.Column="0" Text="Install Path:" FontWeight="Bold" FontSize="12" BorderBrush="Transparent" Background="Transparent" IsReadOnly="True" IsTabStop="False" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,4"/>
                  <TextBox x:Name="InstallPath_Value" Grid.Row="5" Grid.Column="1" Height="24" Width="220" HorizontalAlignment="Left" Background="White" Focusable="True" Margin="0,4"/>
              </Grid>
          </GroupBox>

      </Grid>
